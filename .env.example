DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-supabase-key

# Service-role key (Supabase project settings -> API keys). Server-only,
# used by the admin panel to bypass RLS. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared password for the /admin panel login.
ADMIN_PASSWORD=change-me

# Random 32+ char secret used to encrypt the admin session cookie.
# Generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-secret

PICKUP_ADDRESS="Address here"
PICKUP_HOURS="Pickup hours here"

# WhatsApp Business number to receive checkout messages (wa.me link).
# International format; non-digit characters are stripped automatically.
WHATSAPP_BUSINESS_NUMBER="573001234567"

# 24h "HH:MM" format
# Orders placed before WORKING_HOURS_END can be scheduled for next-day delivery;
# orders placed after it move to the day after next.
WORKING_HOURS_START="07:00"
WORKING_HOURS_END="15:00"

# Delivery time slots are generated in 30 min intervals between these two times.
DELIVERY_HOURS_START="09:00"
DELIVERY_HOURS_END="18:00"