DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-supabase-key

PICKUP_ADDRESS="Address here"
PICKUP_HOURS="Pickup hours here"

# 24h "HH:MM" format
# Orders placed before WORKING_HOURS_END can be scheduled for next-day delivery;
# orders placed after it move to the day after next.
WORKING_HOURS_START="07:00"
WORKING_HOURS_END="15:00"

# Delivery time slots are generated in 30 min intervals between these two times.
DELIVERY_HOURS_START="09:00"
DELIVERY_HOURS_END="18:00"